// Generated by scripts/zmk.mjs. Edit that (or ergogen/config.yaml), not this file.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define FN 1

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
        &kp EQUAL &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
        &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
        &kp ESC   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
        &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
        &kp GRAVE &mo FN    &kp LEFT  &kp RIGHT &kp UP    &kp DOWN  &kp LBKT  &kp RBKT
        &kp BSPC  &kp DEL   &kp LCTRL &kp END   &kp PG_DN &kp RCTRL &kp RET   &kp SPACE
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
        &kp F11        &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F12
        &studio_unlock &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_CLR     &out OUT_TOG   &trans         &trans         &trans         &kp PSCRN      &bootloader
        &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &kp HOME       &kp END        &kp PG_UP      &kp PG_DN      &trans         &trans
        &kp LGUI       &trans         &kp LALT       &trans         &trans         &kp RGUI       &trans         &kp RALT
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
